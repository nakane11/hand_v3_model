(load "../urdf/hand_v3.l")

(hand_v3_model)

;; ("base_link" "adduction_pulley_link" "arm_link1" "arm_link2" "arm_link3" "hand_link" "index_link0" "index_link1" "index_link2" "index_link3" "index_pulley_link" "little_link0" "little_link1" "little_link2" "little_link3" "little_pulley_link" "middle_link0" "middle_link1" "middle_link2" "middle_link3" "middle_pulley_link" "ring_link0" "ring_link1" "ring_link2" "ring_link3" "ring_pulley_link" "thumb_link0" "thumb_link1" "thumb_link2" "thumb_pulley_link")


(defclass marker
  :slots (robot-model marker-tb))

(defmethod marker
  (:init
    (robot)
    (setq robot-model robot)
    (send self :initialize-markers))

  (:get-link-by-name
    (name)
    (dolist (lk (send robot-model :links))
      (when (string-equal (send lk :name) name)
        (return-from :get-link-by-name lk)))
    nil)

  (:marker-object
    ()
    (let ((value-list (send marker-tb :list-values)))
      (nreverse (flatten value-list))))

  (:make-marker
    (pos color)
    (setq cyl (make-cylinder 6 1))
    (send cyl :replace-pos pos)
    (send cyl :rotate (/ pi 2) :y)
    (send cyl :translate (float-vector 3 0 0) :world)
    (send cyl :set-color color)
    cyl)

  (:make-palm-marker
    (pos color)
    (setq cyl (make-cube 40 40 1))
    (send cyl :replace-pos pos)
    (send cyl :rotate (/ pi 2) :y)
    (send cyl :set-color color)
    cyl)

  (:initialize-markers
    ()
    (setq marker-tb (make-hash-table :test #'string-equal))
    (setq original-color #f(1.0 0.2 0.2 0.6))
    (dolist (finger (list "index" "middle" "ring" "little"))
      (let* ((link1 (send self :get-link-by-name (format nil "~A_link1" finger)))
             (link2 (send self :get-link-by-name (format nil "~A_link2" finger)))
             (link3 (send self :get-link-by-name (format nil "~A_link3" finger)))
             (pos1 (scale 0.5 (v+ (send (send link1 :copy-worldcoords) :pos) (send (send link2 :copy-worldcoords) :pos))))
             (pos2 (scale 0.5 (v+ (send (send link2 :copy-worldcoords) :pos) (send (send link3 :copy-worldcoords) :pos))))
             (pos3 (send (send (send link3 :copy-worldcoords) :translate (float-vector -1.5 0 12) :world) :copy-pos))
             (cyl1 (send self :make-marker pos1 original-color))
             (cyl1-l (send self :make-marker pos1 original-color))
             (cyl1-r (send self :make-marker pos1 original-color))
             (cyl2 (send self :make-marker pos2 original-color))
             (cyl2-l (send self :make-marker pos2 original-color))
             (cyl2-r (send self :make-marker pos2 original-color))
             (cyl3 (send self :make-marker pos3 original-color)))
        (send cyl1-l :rotate (deg2rad -80) :z :world)
        (send cyl1-l :translate (float-vector -5 -6 0) :world)
        (send cyl1-r :rotate (deg2rad 80) :z :world)
        (send cyl1-r :translate (float-vector -5 6 0) :world)
        (send cyl2-l :rotate (deg2rad -80) :z :world)
        (send cyl2-l :translate (float-vector -5 -6 0) :world)
        (send cyl2-r :rotate (deg2rad 80) :z :world)
        (send cyl2-r :translate (float-vector -5 6 0) :world)
        (send cyl3 :rotate (deg2rad -12) :y)
        (send link1 :assoc cyl1)
        (send link1 :assoc cyl1-l)
        (send link1 :assoc cyl1-r)
        (send link2 :assoc cyl2)
        (send link1 :assoc cyl2-l)
        (send link1 :assoc cyl2-r)
        (send link3 :assoc cyl3)
        (sethash (send link1 :name) marker-tb cyl1)
        (sethash (format nil "~A-l" (send link1 :name)) marker-tb cyl1-l)
        (sethash (format nil "~A-r" (send link1 :name)) marker-tb cyl1-r)
        (sethash (send link2 :name) marker-tb cyl2)
        (sethash (format nil "~A-l" (send link2 :name)) marker-tb cyl2-l)
        (sethash (format nil "~A-r" (send link2 :name)) marker-tb cyl2-r)
        (sethash (send link3 :name) marker-tb cyl3)
        ))
    (let* ((thumb-link0 (send self :get-link-by-name "thumb_link0"))
           (thumb-link1 (send self :get-link-by-name "thumb_link1"))
           (thumb-link2 (send self :get-link-by-name "thumb_link2"))
           (pos0 (send (send (send thumb-link0 :copy-worldcoords) :translate (float-vector -1.5 0 12) :world) :copy-pos))
           (pos1 (scale 0.5 (v+ (send (send thumb-link1 :copy-worldcoords) :pos) (send (send thumb-link2 :copy-worldcoords) :pos))))
           (pos2 (send (send (send thumb-link2 :copy-worldcoords) :translate (float-vector -1.5 0 12) :world) :copy-pos))
           (cyl0 (send self :make-marker pos0 original-color))
           (cyl1 (send self :make-marker pos1 original-color))
           (cyl2 (send self :make-marker pos2 original-color)))
      (send cyl1 :replace-rot (send (send thumb-link1 :copy-worldcoords) :copy-rot))
      (send cyl2 :replace-rot (send (send thumb-link2 :copy-worldcoords) :copy-rot))
      (send cyl0 :translate #f(2 15 0) :world)
      (send cyl1 :translate #f(0 0 -2) :local)
      (send cyl2 :rotate (deg2rad -20) :y :local)
      (send cyl2 :translate #f(2 5 2) :local)
      (send thumb-link0 :assoc cyl0)
      (send thumb-link1 :assoc cyl1)
      (send thumb-link2 :assoc cyl2)
      (sethash (send thumb-link0 :name) marker-tb cyl0)
      (sethash (send thumb-link1 :name) marker-tb cyl1)
      (sethash (send thumb-link2 :name) marker-tb cyl2)
      )
    (let* ((hand-link (send self :get-link-by-name "hand_link"))
           (pos (send (send hand-link :copy-worldcoords) :copy-pos))
           (cyl (send self :make-palm-marker pos original-color)))
      (send cyl :translate #f(18 0 60) :world)
      (send hand-link :assoc cyl)
      (sethash (send hand-link :name) marker-tb cyl)
    ))

  (:set-color
    (name &key rgb a)
    (let ((target (gethash name marker-tb)))
      (when target
        (let ((new-color (copy-seq (send target :get :face-color))))
          (when rgb
            (replace new-color rgb :end1 3))
          (when a
            (setf (elt new-color 3) a))
          (send target :set-color new-color)
          ))))
  )

(setq *marker* (instance marker :init *hand_v3_model*))
(send *marker* :initialize-markers)
(setq markers (send *marker* :marker-object))

(unless (boundp '*irtviewer*)
  (make-irtviewer))
(send *irtviewer* :viewer :viewing :look #f(469.478 -22.6601 396.048) #f(-19.9775 11.566 370.334) #f(0.0 0.0 1.0))
(send *irtviewer* :objects (append (list *hand_v3_model*) markers))
(send *irtviewer* :draw-objects)

(ros::roseus "visualize_marker")
(defun sensor-to-transparency (val)
  (* 2.0 (/ val 4096)))
(defun sensor-cb (msg)
  (let ((sensor-data (send msg :data))
        (sensor-tb (make-hash-table :test #'string-equal)))
    (sethash "index" sensor-tb (subseq sensor-data 1 8))
    (sethash "middle" sensor-tb (subseq sensor-data 9 16))
    (sethash "ring" sensor-tb (subseq sensor-data 17 24))
    (sethash "little" sensor-tb (subseq sensor-data 25 32))

    (dolist (finger-data (send sensor-tb :list))
      (let ((finger-name (car finger-data))
            (finger-values (cdr finger-data)))
        (send *marker* :set-color (format nil "~A_link1-r" finger-name) :a (sensor-to-transparency (elt finger-values 0)))
        (send *marker* :set-color (format nil "~A_link1" finger-name) :a (sensor-to-transparency (elt finger-values 1)))
        (send *marker* :set-color (format nil "~A_link1-l" finger-name) :a (sensor-to-transparency (elt finger-values 2)))
        (send *marker* :set-color (format nil "~A_link2-r" finger-name) :a (sensor-to-transparency (elt finger-values 3)))
        (send *marker* :set-color (format nil "~A_link2" finger-name) :a (sensor-to-transparency (elt finger-values 4)))
        (send *marker* :set-color (format nil "~A_link2-l" finger-name) :a (sensor-to-transparency (elt finger-values 5)))
        (send *marker* :set-color (format nil "~A_link3" finger-name) :a (sensor-to-transparency (elt finger-values 6)))
        ))
    (send *marker* :set-color "hand_link" :a (sensor-to-transparency (elt sensor-data 0)))
    (send *marker* :set-color "thumb_link0" :a (sensor-to-transparency (elt sensor-data 8)))
    (send *marker* :set-color "thumb_link1" :a (sensor-to-transparency (elt sensor-data 16)))
    (send *marker* :set-color "thumb_link2" :a (sensor-to-transparency (elt sensor-data 24)))
      )
  (send *irtviewer* :draw-objects))
(ros::subscribe "force_data_diff" std_msgs::Float32MultiArray #'sensor-cb)

(do-until-key
 (ros::spin-once)
 (x::window-main-one)
 )
